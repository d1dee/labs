# Better Auth Configuration
# Generate a secure secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-at-least-32-chars

# Base URL of the application
BETTER_AUTH_URL=http://localhost:3000

# Resend transactional email. Use a sender on a domain verified in Resend.
# Required for signup, verification resend and password recovery. Never expose these in VITE_* variables.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL="Labs FCD <auth@your-verified-domain.example>"
# Additional frontend origins, comma-separated (needed for a separately hosted frontend).
TRUSTED_ORIGINS=http://localhost:5173

# Environment (production enables secure cookies)
NODE_ENV=development

# Allow user sign up (disabled by default for security)
# Set to 'true' to enable new user registration
ALLOW_SIGNUP=false

# Data usage snapshot interval in milliseconds (default: 300000 = 5 minutes)
DATA_USAGE_SNAPSHOT_INTERVAL=300000

# Veyon screenshot polling (backend-driven; browsers only receive pushed
# frames). One serialized polling worker per machine with exponential
# backoff after failures and a global request concurrency cap.
# Grid profile defaults; query width/quality/intervalMs/priority override per subscription.
# VEYON_POLL_INTERVAL_MS=5000        # grid interval; shared worker uses fastest active profile
# VEYON_POLL_TIMEOUT_MS=5000         # one deadline after resource admission, including auth/body
# VEYON_POLL_MAX_BACKOFF_MS=10000    # failure backoff ceiling
# VEYON_POLL_JITTER_MS=300           # random 0..N ms added per machine
# VEYON_POLL_GLOBAL_CONCURRENCY=8    # max simultaneous Veyon screenshot requests
# VEYON_POLL_IDLE_LINGER_MS=5000     # keep connection only; network stops immediately at zero refs
# VEYON_POLL_FRAME_WIDTH=320
# VEYON_POLL_FRAME_QUALITY=50
# VEYON_VIEWER_INTERVAL_MS=1000
# VEYON_VIEWER_FRAME_WIDTH=1280
# VEYON_VIEWER_FRAME_QUALITY=75
# Admission happens before network slots. Viewer/grid FIFO weighting is 3:1.
# VEYON_ORG_REQUESTS_PER_SECOND=12  # screenshot poll admissions (auth/session retry HTTP calls are separate)
# VEYON_ORG_REQUEST_BURST=4          # initial/refill request allowance
# VEYON_ORG_BYTES_PER_SECOND=524288  # 512 KiB/s, charged against actual received frame bytes
# VEYON_ORG_BYTE_BURST=524288        # 512 KiB allowance; oversized estimates create repaid debt
# VEYON_ORG_CONCURRENCY=4            # bounds under-estimate overshoot and global slot occupancy
# VEYON_MAX_PENDING_REQUESTS=512    # bounded admission queue, across organizations
# VEYON_MAX_PENDING_PER_ORG=256     # prevents one organization monopolizing the queue
# VEYON_ESTIMATED_FRAME_BYTES=32768 # first poll reservation; later polls use previous frame size
# VEYON_MAX_FRAME_BYTES=2097152     # reject frames over 2 MiB
# VEYON_MAX_RETAINED_BYTES=33554432 # shared 32 MiB cap, including active worker snapshots
# VEYON_RETAINED_MAX_AGE_MS=60000
# VEYON_MAX_RETAINED_STATES=128
# VEYON_STREAM_MAX_PENDING_BYTES=8388608 # per SSE stream queued image bytes; at least MAX_FRAME_BYTES
# Byte under-estimation is debt, not forgiven: worst extra burst is at most
# ORG_CONCURRENCY * MAX_FRAME_BYTES (plus transport read-chunk overhead).
