# Better Auth Configuration
# Generate a secure secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-at-least-32-chars

# Base URL of the application
BETTER_AUTH_URL=http://localhost:3000

# Environment (production enables secure cookies)
NODE_ENV=development

# Allow user sign up (disabled by default for security)
# Set to 'true' to enable new user registration
ALLOW_SIGNUP=false

# Data usage snapshot interval in milliseconds (default: 300000 = 5 minutes)
DATA_USAGE_SNAPSHOT_INTERVAL=300000

# Pi-hole Configuration
# URL to your Pi-hole instance (e.g., https://192.168.1.23)
PIHOLE_URL=https://192.168.1.23

# Pi-hole Web Interface Password (used for session-based authentication)
PIHOLE_PASSWORD=
